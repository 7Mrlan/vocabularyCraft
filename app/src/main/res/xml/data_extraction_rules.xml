<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ cloud backup and device transfer: keep the TTS secret local. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="tts.encrypted" />
        <exclude domain="file" path="tts.encrypted.bak" />
        <exclude domain="file" path="tts.encrypted.new" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="tts.encrypted" />
        <exclude domain="file" path="tts.encrypted.bak" />
        <exclude domain="file" path="tts.encrypted.new" />
    </device-transfer>
</data-extraction-rules>
